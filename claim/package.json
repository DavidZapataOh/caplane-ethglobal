{
  "name": "@caplane/claim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:wasm": "bun build tools/probe.ts --target=browser --format=esm --outfile=/tmp/caplane-probe.js >/dev/null && javy build -C deterministic=y /tmp/caplane-probe.js -o /tmp/caplane-probe.wasm",
    "derive:wasm": "bun run build:wasm >/dev/null 2>&1 && node --no-warnings tools/run-wasi.mjs /tmp/caplane-probe.wasm"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "5.9.3"
  }
}
