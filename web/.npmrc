# @privy-io/react-auth declares `permissionless` as an optional peer, and permissionless in turn
# declares a stale optional peer on ox ^0.8 — while viem 2.56 resolves ox 0.14. npm refuses the
# whole install over a peer it never actually installs: `permissionless` is absent from the
# resulting tree, verified with `npm ls permissionless`. Nothing in this app uses account
# abstraction, so the conflict is hypothetical and the tree is sound.
legacy-peer-deps=true
