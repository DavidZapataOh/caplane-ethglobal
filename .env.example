ARC_TESTNET_RPC_URL=
ARC_TESTNET_CHAIN_ID=5042002
CAPLANE_FORWARDER_ADDRESS=0x76c9cf548b4179F8901cda1f8623568b58215E62
ARC_TESTNET_EXPLORER_URL=https://testnet.arcscan.app
ARC_TESTNET_DEPLOYER_ADDRESS=
ARC_TESTNET_DEPLOYER_PRIVATE_KEY=
CRE_ETH_PRIVATE_KEY=
CAPLANE_VAULT_PROBE_VALUE=
LEDGER_APP_ID=
LEDGER_APP_PASSPHRASE=
WATCHLIST_SUBSCRIPTION=
NOTIFY_TRANSPORT_KEY=
NOTIFY_TEST_RECIPIENT=
NEXT_PUBLIC_PRIVY_PUBLIC_APP=
PRIVY_SERVER_CREDENTIAL=
HARNESS_SIGNER_SECRET=
HARNESS_SIGNER_ADDRESS=
ENCLAVE_ENVELOPE_KEY=
CAPLANE_ENVELOPE_KEY=
COMMITMENT_PEPPER=
CAPLANE_INDEX_SALT=

# --- Deployment -------------------------------------------------------------------------------
# The workflow's name, hashed into the registry as an immutable at deploy time. Changing it after
# the registry is deployed orphans every lien: the report still gets signed by the DON and
# transmitted by the forwarder, and `onReport` rejects it for ever — there is no setter, and a
# redeployment would abandon every lien recorded until then. The CRE workflow must register under
# exactly this string.
WORKFLOW_NAME=caplane-registry
# bytes10 of the first ten HEX CHARACTERS of sha256(WORKFLOW_NAME), taken as ASCII bytes —
# not the decoded hex. Derived a second time inside the deploy script and compared against this
# value before anything is broadcast, because the chain accepts a wrong name in silence.
WORKFLOW_NAME_BYTES10=0x33396465656661623966
# The address that owns the workflow in the CRE registry. EIP-55 checksummed: a lowercase address
# copied into a Solidity literal fails to compile with Error (9429).
WORKFLOW_OWNER=0xd5557A1d0806323caD77bC4049ccaca0EaDAaf06
# KeystoneForwarder on Arc Testnet — the registry's only accepted caller.
CHAIN_FORWARDER=0x76c9cf548b4179F8901cda1f8623568b58215E62
# Arc Testnet's CCIP chain selector, from `cre supported-chains --output json`. Exceeds
# Number.MAX_SAFE_INTEGER, so it is a string everywhere it is read by JavaScript.
CHAIN_SELECTOR=3034092155422581607
# Native USDC. Its `balanceOf` is the account's native balance divided by 1e12, not a ledger.
CHAIN_USDC=0x3600000000000000000000000000000000000000
# The deploying account's key. Never committed; `.env` is gitignored.
DEPLOYER_KEY=

# --- Demo actors ------------------------------------------------------------------------------
# Generated locally with `cast wallet new`. Testnet only, and never reused anywhere else: the
# faucet is the sole source of funds on this chain and gives 20 USDC per address every two hours,
# so each role is its own address and each one has to be claimed ahead of a demonstration.
# The business that submits the claim and receives the advance. Needs gas only.
BORROWER_ADDRESS=
BORROWER_KEY=
# The customer who owes the invoice and pays it into the escrow. Needs the invoice's FACE VALUE,
# which is larger than the advance — the pot nobody had budgeted.
DEBTOR_ADDRESS=
DEBTOR_KEY=
# A second depositor, so the vault is not a single-holder vault when the loss paths are shown.
INVESTOR_ADDRESS=
INVESTOR_KEY=

# How often the activity index polls the chain, in milliseconds. Default 5000.
POLL_INTERVAL_MS=

# Debtor confirmation. A SEPARATE accounting connection, scoped accounting.contacts.read and
# nothing else: measured, a token on that scope answers 401 to the invoice route, which is the only
# reason a ledger credential is allowed on a platform surface at all. Never point these at
# LEDGER_APP_* — that pair can read the invoice, and a copy of it on a server of ours is the gap
# this design claims to close.
LEDGER_CONTACTS_ID=
LEDGER_CONTACTS_PASSPHRASE=
# HMAC key for the one-time confirmation link. 32 characters or more.
LINK_SIGNING_KEY=
# Where the browser reaches the confirmation service. Forbidden under web/app/**/registry/ by the
# registry-reads-chain-only rule, and correct here: the confirmation page is an app surface.
NEXT_PUBLIC_API_URL=
# Where the emailed link points. Defaults to the app surface.
CONFIRM_LINK_BASE=
# The endpoint the public registry page reads from, in the browser. Public, no credential — and
# measured: all three Arc endpoints send CORS headers and reflect the requesting origin. Not a
# backend of ours, which is why registry-reads-chain-only permits it where it forbids an API URL.
NEXT_PUBLIC_ARC_RPC_URL=
